# pnpm setup generates unique secrets. Never commit .env.
POSTGRES_USER=suns
POSTGRES_DB=suns
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://suns:GENERATE_POSTGRES_PASSWORD@localhost:5432/suns
REDIS_URL=redis://localhost:6379
PAYLOAD_SECRET=GENERATE_PAYLOAD_SECRET
# Dedicated AES-GCM key for GEO model credentials. Regional workers need the same value.
GEO_MONITOR_SECRET=GENERATE_GEO_MONITOR_SECRET
MARKETING_UNSUBSCRIBE_SECRET=GENERATE_MARKETING_UNSUBSCRIBE_SECRET
MARKETING_DELIVERY_URL=
MARKETING_DELIVERY_TOKEN=
# Only the regional GEO worker entrypoint requires GEO_WORKER_REGION_CODE.
GEO_WORKER_REGION_CODE=
GEO_WORKER_ID=
GEO_WORKER_CONCURRENCY=3
CMS_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
DEFAULT_LOCALE=en
DEPLOYMENT_ENV=development
TRUST_PROXY=0
STORAGE_PROVIDER=local
# MEDIA_DIR and STATIC_OUTPUT_DIR are resolved from each app's cwd; Docker sets absolute paths.
MEDIA_DIR=../../media
STATIC_OUTPUT_DIR=../../static-site
MEDIA_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional password-reset mail. Use a verified sender in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Schema changes are deployed by migrations, never automatic production pushes.
PAYLOAD_SCHEMA_PUSH=false

# Optional DeepSeek fallback. Administrators can configure the key and model in Auto Translation > LLM Settings.
TRANSLATION_API_KEY=
TRANSLATION_MODEL=deepseek-flash
TRANSLATION_API_URL=https://api.deepseek.com/chat/completions
